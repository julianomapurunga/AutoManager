# ─── Banco de dados (Supabase Postgres) ─────────────────────────────────────
# Painel do Supabase > Connect (topo da página) > ORMs / Connection String.
# Use a connection string do "Transaction pooler" (porta 6543) ou
# "Session pooler" (porta 5432). Substitua [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ─── Supabase (servidor) ─────────────────────────────────────────────────────
# Painel do Supabase > Settings > API
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Settings > API Keys > service_role (secreta! nunca exponha no frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Apenas para projetos Supabase antigos que usam JWT HS256 (Settings > API > JWT Secret).
# Projetos novos usam chaves assimétricas e NÃO precisam desta variável.
# SUPABASE_JWT_SECRET=

# ─── Supabase (frontend / Vite) ──────────────────────────────────────────────
# Mesma URL do projeto + chave pública (anon / publishable)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=5000

# ─── Asaas (pagamentos) ──────────────────────────────────────────────────────
# Sandbox: crie conta em https://sandbox.asaas.com e pegue a chave em
# Configurações da conta > Integrações > Chave de API
# ⚠️ A chave do Asaas começa com "$". No docker-compose (env_file interpola),
#    escape como $$ — ex.: ASAAS_API_KEY=$$aact_... — senão o compose interpreta
#    o $ como variável e a chave chega VAZIA no container. Localmente (npm run
#    dev / dotenv), use o valor literal com um $ só.
ASAAS_API_KEY=
# URL da API (deixe assim para sandbox; produção: https://api.asaas.com/v3)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Token que VOCÊ define ao cadastrar o webhook no painel do Asaas (valida a origem)
ASAAS_WEBHOOK_TOKEN=

# ─── SMTP (envio de e-mails do suporte) ──────────────────────────────────────
# Gmail: ative a verificação em 2 etapas e crie uma "Senha de app" em
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=irontechti@gmail.com
SMTP_PASS=

# ─── Super Admin (painel do dono do SaaS) ────────────────────────────────────
# Único e-mail com acesso a /admin. Crie este usuário no Supabase
# (Authentication > Users > Add user) — ele NÃO deve ter loja cadastrada.
SUPER_ADMIN_EMAIL=irontechti@gmail.com
